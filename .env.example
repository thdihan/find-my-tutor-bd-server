# Server Configuration
NODE_ENV=development
PORT=8000

# Client Origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database with PostGIS
DATABASE_URL=postgresql://tutor_admin:secure_dev_password@localhost:5432/find_my_tutor_db

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=find_my_tutor_bd_access_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=find_my_tutor_bd_refresh_secret_super_secure_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing
BCRYPT_SALT_ROUNDS=12
